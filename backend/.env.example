# Copy to .env and fill in. .env is git-ignored; this file must never contain real values.
DJANGO_SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Only needed when the frontend is served from a different origin than the API.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set when running behind a reverse proxy that terminates TLS.
DJANGO_BEHIND_PROXY=false
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5433/fnp
DATABASE_POOL_MAX=10
# Production with several server processes: a shared cache (pip install redis), e.g. redis://127.0.0.1:6379/0
REDIS_URL=
# Encrypts personal identifiers at rest. Generate with:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Keep it safe: losing it makes stored ID numbers unreadable.
# One or more Fernet keys, comma-separated; the first encrypts. To rotate, prepend the new key.
FIELD_ENCRYPTION_KEY=
ENGINE_BASE_URL=http://40.81.225.53:8000
ENGINE_TIMEOUT_SECONDS=30
ENGINE_POLL_INTERVAL_SECONDS=5
MEDIA_ROOT=media
EVIDENCE_MAX_BYTES=15728640
# Page requests follow running engine cases themselves. Set false when the follow_runs worker runs
# (always, on a server), so no page ever waits on the engine.
ENGINE_FOLLOW_IN_REQUESTS=true
# The passwordless development sign-in (any email; "admin" is the reviewer). Defaults to DJANGO_DEBUG.
# Turning it on where DEBUG is off lets anyone who can reach the site sign in as anyone.
DEV_SIGN_IN=
# Leave unset (HTTPS whenever DEBUG is off). false only for a proof-of-concept server on plain HTTP.
DJANGO_HTTPS=
